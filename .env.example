# ==========================================
# Telegram Bot Configuration
# ==========================================
# Основной информационный бот (получите токен у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Бот критических ликвидаций и сирены (второй бот @BotFather)
CRITICAL_TELEGRAM_BOT_TOKEN=your_critical_bot_token_here

# Ваш числовой ID чата (узнайте через бота @userinfobot или @myidbot)
TELEGRAM_CHAT_ID=your_chat_id_here

# ==========================================
# Cloud Deployment & Healthcheck
# ==========================================
# Порт для микро-сервера /health (на Render.com задается автоматически или 8080)
PORT=8080

# Отключение поллинга Telegram (выставьте true в локальном .env на ПК, чтобы не конфликтовать с облачным ботом)
DISABLE_POLLING=false

# ==========================================
# GitHub REST API Sync (для облачного воркера Render)
# ==========================================
# Fine-grained Personal Access Token (PAT) с правами Contents: Read & Write на репозиторий Lighter
GITHUB_PAT=github_pat_xxxxxx
GITHUB_REPO=Swager2k1/Lighter
GITHUB_BRANCH=main
